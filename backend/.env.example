APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_platform

# KIS Open API - 모의투자(VTS)
# https://apiportal.koreainvestment.com 에서 모의투자용 앱키/앱시크리트를 발급받는다.
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호, 형식: "12345678-01" (앞 8자리-뒤 2자리)
KIS_ACCOUNT_NO=
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443
