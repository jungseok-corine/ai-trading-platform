APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_platform

# pytest 실행 시 사용할 테스트 전용 DB (지정하지 않으면 trading_platform_test를 기본값으로 사용)
# TEST_DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_platform_test

# KIS Open API - 모의투자(VTS)
# https://apiportal.koreainvestment.com 에서 모의투자용 앱키/앱시크리트를 발급받는다.
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호, 형식: "12345678-01" (앞 8자리-뒤 2자리)
KIS_ACCOUNT_NO=
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443

# KIS Open API - 실전투자 (C-2.13 Real Account Read-Only Verification)
# 실전 계좌는 모의 계좌와 별도 앱키/시크릿/계좌번호를 사용한다.
# https://apiportal.koreainvestment.com 에서 실전투자용 앱키/앱시크리트를 발급받는다.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
# 실전 계좌번호, 형식: "12345678-01"
KIS_REAL_ACCOUNT_NO=

# 실전 주문 활성화 플래그 — 기본값 false (read-only 모드).
# 반드시 read-only 검증 완료 후 사람이 명시적으로 true로 변경한다.
# AI 분석 결과나 자동화 코드가 이 값을 변경해서는 안 된다.
# KIS_REAL_TRADING_ENABLED=false

# 미국장 데이터 수집 (C-2.44/C-2.48). 기본 provider는 "manual"(외부 호출 없음).
# 권장: "fred_twelvedata" — FRED가 VIX/금리/S&P500/나스닥, Twelve Data가 SOX(SOXX) 보강.
# US_MARKET_PROVIDER=fred_twelvedata
# FRED 무료 키: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Twelve Data 무료 키: https://twelvedata.com/apikey  (SOX는 SOXX ETF proxy 사용)
TWELVEDATA_API_KEY=
# SOX 대용 심볼(기본 SOXX). 다른 ETF/심볼로 바꿀 수 있다.
# US_MARKET_SOX_SYMBOL=SOXX
# 매일 자동 수집을 켜려면 true (KST 07:00, 미국장 마감 후). 기본 비활성.
# US_MARKET_REFRESH_SCHEDULER_ENABLED=true

# 일일 AI 분석 잡 (C-2.54). 기본 비활성 + 기본 provider fake(실수 유료호출 방지).
# 켜려면 true + provider/model 지정. A/B 기간엔 mode=dual로 Claude+GPT 둘 다 매일.
# AI_DAILY_ANALYSIS_ENABLED=true
AI_ANALYSIS_MODE=single                 # single | dual(A/B)
AI_ANALYSIS_PROMPT_TYPE=improvement     # overview | risk | improvement
AI_ANALYSIS_PROVIDER=fake               # fake | anthropic | openai
# AI_ANALYSIS_MODEL=claude-sonnet-4-6
AI_ANALYSIS_SECONDARY_PROVIDER=fake     # dual일 때 2차 (예: openai)
# AI_ANALYSIS_SECONDARY_MODEL=gpt-5.4
# 활동량 게이트 임계값
AI_ANALYSIS_FEW_THRESHOLD=3
AI_ANALYSIS_MANY_THRESHOLD=15
AI_ANALYSIS_ACTIVE_RANGE_PCT=2.0
AI_ANALYSIS_ACTIVE_NOTABLE=3

# DART 전자공시 수집 (C-2.59). 무료 키: https://opendart.fss.or.kr (인증키 신청)
# 보유/관심 종목의 '중요' 공시만 저장(중요도 미달 노이즈 제외). 주문과 무관한 read-only 수집.
DART_API_KEY=
# 장중 자동 폴링을 켜려면 true (기본 비활성, 10분 간격)
# DART_INGEST_SCHEDULER_ENABLED=true

# SEC EDGAR 미국 공시 수집 (C-5.20). 키 불필요(무료)이나 SEC 정책상 '연락처가 담긴' User-Agent 필수.
# 본인 앱 이름 + 연락 이메일로 설정하세요 (예: "MyApp your-email@example.com").
# 미설정/형식 불량/초당 10요청 초과 시 SEC가 403 "Request Rate Threshold Exceeded"로 차단합니다.
# SEC_EDGAR_USER_AGENT=YourApp your-contact@example.com
# 연속 요청 사이 최소 간격(초). SEC 10 req/s 제한을 넘지 않게 한다(기본 0.2).
# EDGAR_MIN_REQUEST_INTERVAL_SECONDS=0.2
# 장중 자동 폴링을 켜려면 true (기본 비활성, 30분 간격)
# EDGAR_INGEST_SCHEDULER_ENABLED=true
